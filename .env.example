# ClientOps AI - Environment Configuration

# IBM watsonx.ai Credentials (Get free access from https://dataplatform.cloud.ibm.com)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# Application Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default (Zero-configuration SQLite):
DATABASE_URL=sqlite:///./data/clientops.db

# Production Enterprise (PostgreSQL):
# DATABASE_URL=postgresql://clientops:clientops_secure_pass123@localhost:5432/clientops_db
